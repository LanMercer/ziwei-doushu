# 复制为 .env.local（本地）或填到平台的环境变量面板（线上）

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 排盘不需要 Key；只有点「解读」时才用得到。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 通用覆盖（优先级高于上面的厂商配置）───
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 隐私 ───
# 默认只把排盘结果（十二宫/四化/大限/格局）发给模型，
# 不含姓名、出生地、经纬度、公历生日、四柱。
# 想连生辰一起发给模型时打开（不建议）：
# PRIVACY_INCLUDE_BIRTH=1

# ─── 上线防护（建议线上开启）───
# 访问口令：设了以后前端必须先输入口令才能调用解读接口；留空则不校验。
# ACCESS_CODE=your-secret-code

# 限流默认值：每 IP 每分钟 3 次 / 每 IP 每天 30 次 / 全站每天 400 次
# RATE_PER_MINUTE=3
# RATE_PER_DAY_IP=30
# RATE_PER_DAY_GLOBAL=400
